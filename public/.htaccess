# Confronto auto (Angular), pubblicata in /extra/confronto-auto/
# Angular copia questo file nella build (cartella public/): va caricato insieme agli altri.

# Niente elenco dei file se qualcuno apre una cartella
Options -Indexes

RewriteEngine On
RewriteBase /extra/confronto-auto/

# 1) L'API PHP ha il suo .htaccess: qui non la tocchiamo
RewriteRule ^api/ - [L]

# 2) File e cartelle che esistono davvero (main-XXXX.js, styles-XXXX.css, favicon.ico): serviti così come sono
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) Tutto il resto (/settings, /login, /register...) è una "pagina" di Angular: rispondo con index.html
#    e poi è il router di Angular a mostrare la pagina giusta. Senza questa regola, ricaricando
#    /extra/confronto-auto/settings Aruba risponderebbe 404.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Un po' di sicurezza in più per le pagine dell'app
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # index.html va sempre ricontrollato: così dopo ogni pubblicazione il browser prende subito i file nuovi
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # js e css hanno un "hash" nel nome (main-AB12CD.js) che cambia a ogni build: possono stare in cache un anno
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
